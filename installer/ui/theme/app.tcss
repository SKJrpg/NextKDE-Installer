/* Layout only: colours stay the terminal's own. */

#body {
    height: 1fr;
}

#sidebar {
    width: 22;
    height: 1fr;
    padding: 1 2 0 1;
}

#main {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

#intro {
    height: auto;
    padding-bottom: 1;
}

#facts {
    height: auto;
}

#summary {
    height: auto;
    padding-bottom: 1;
}

#probes {
    height: 1fr;
}
