/* The terminal's own background shows through, and text is the terminal's
   default colour, so light and dark terminals both stay readable. Only the
   focused row, the modal surface, the scrollbar thumb and the progress fill
   keep a colour of their own.
   `ansi_default` is what Textual must render for the terminal palette to
   show: a transparent root is painted black by the compositor. */
App, Screen {
    background: ansi_default;
    color: ansi_default;
}

Header, Footer {
    background: transparent;
    color: ansi_default;
}

/* The hint line is painted from the key table, not from Textual's footer. */
KeyFooter {
    height: 1;
    padding: 0 1;
    background: transparent;
    color: ansi_default;
    text-wrap: nowrap;
}

FooterKey, FooterLabel,
FooterKey > .footer-key--key,
FooterKey > .footer-key--description {
    background: transparent;
    color: ansi_default;
}

FooterKey:hover {
    background: transparent;
    text-style: underline;
}

/* One line tall. Focus reads without colour: bold reverse is the terminal's
   own swap, and the hover cue is an underline. */
Button {
    height: 1;
    min-width: 8;
    padding: 0 1;
    border: none;
    background: transparent;
    color: ansi_default;
}

Button.-primary {
    text-style: bold;
}

Button.-error {
    color: ansi_red;
}

Button:hover {
    background: transparent;
    text-style: underline;
}

Button:focus {
    background: transparent;
    text-style: bold reverse;
}

Button:disabled {
    background: transparent;
    color: ansi_default;
    text-style: dim;
}

/* The check and radio markers are text on the terminal, not filled blocks. */
ToggleButton, RadioSet {
    background: transparent;
}

ToggleButton > .toggle--button {
    background: transparent;
    color: ansi_default;
}

ToggleButton.-on > .toggle--button {
    background: transparent;
    color: ansi_green;
}

#log, #action_log, #log_view, #manage_list {
    background: transparent;
    color: ansi_default;
}

/* The scrollbar rail must not paint a pane; its thumb is the terminal's own
   foreground. */
Widget {
    /* Textual defaults the vertical bar to 2 cells; one is enough. */
    scrollbar-size: 1 1;
    scrollbar-background: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-background-active: transparent;
    scrollbar-color: ansi_default;
    scrollbar-color-hover: ansi_default;
    scrollbar-color-active: ansi_default;
}

ProgressBar Bar > .bar--bar,
ProgressBar Bar > .bar--indeterminate,
ProgressBar Bar > .bar--complete {
    background: transparent;
}

#body {
    height: 1fr;
}

#sidebar {
    width: 22;
    height: 1fr;
    padding: 1 2 0 1;
}

#main {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

#banner {
    height: auto;
    padding-bottom: 1;
}

#intro {
    height: auto;
    padding-bottom: 1;
}

#summary {
    height: auto;
    padding-bottom: 1;
}

#probes {
    height: 1fr;
    width: 1fr;
}

/* A probe row is one line; its value is clipped, never wrapped into the margin. */
#probes Static {
    text-wrap: nowrap;
}

/* Wider terminals get the focused row's explanation beside the list; narrower
   ones stack it under the list, where it keeps its own scroll. */
#checks_split, #options_split {
    height: 1fr;
}

#checks_split.-wide, #options_split.-wide {
    layout: horizontal;
}

#probe_detail, #option_detail {
    height: auto;
    max-height: 7;
    margin-top: 1;
}

#probe_detail.-wide, #option_detail.-wide {
    width: 40;
    height: 1fr;
    max-height: 100%;
    margin: 0 0 0 1;
}

#option_detail.-hidden {
    display: none;
}

/* Options scrolls as one column; the panes keep their own height. */
#options, #review {
    height: 1fr;
    width: 1fr;
}

#options_head, #status, #steps, #side, #hint,
#install_head, #progress_state, #log_path, #local_state {
    height: auto;
}

#install_head {
    width: 1fr;
    padding-bottom: 1;
}

/* The clone's own line can be longer than the pane; one line, clipped. */
#progress_state {
    text-wrap: nowrap;
}

#install_head_row {
    height: auto;
}

#activity {
    width: 9;
    height: 1;
    margin: 0 0 0 1;
}

.group {
    text-style: bold;
    padding-top: 1;
}

#sources {
    height: auto;
    border: none;
}

#stages_box {
    height: auto;
    max-height: 6;
    margin-bottom: 1;
}

#stages {
    height: auto;
}

#log {
    height: 1fr;
    min-height: 3;
    border: none;
}

#cancel {
    width: auto;
    min-width: 12;
    margin-top: 1;
}

#result_head {
    height: auto;
    padding-bottom: 1;
}

#result_body {
    height: 1fr;
}

#result_text {
    height: auto;
}

#actions {
    height: auto;
}

#actions Button {
    min-width: 12;
    margin-right: 1;
}

/* -- management: list, action log, confirmation ---------------------- */
#manage_head {
    height: auto;
    padding: 1 2 0 2;
}

#manage_list {
    height: auto;
    max-height: 12;
    margin: 1 2 0 2;
    border: none;
}

#action_status {
    height: auto;
    padding: 0 2;
}

#action_log, #log_view {
    height: 1fr;
    min-height: 4;
    margin: 0 2 1 2;
    border: none;
}

ConfirmDialog {
    align: center middle;
    background: transparent;
}

/* The dialog is the one surface that stands above the terminal: it separates
   the confirmation from the list behind it. */
#confirm_box {
    width: 62;
    height: auto;
    max-height: 80%;
    border: round $foreground;
    background: $surface;
    color: $text;
    padding: 1 2;
}

#confirm_title {
    height: auto;
    text-style: bold;
}

#confirm_body {
    height: auto;
    margin-top: 1;
}

#confirm_hint {
    height: auto;
    margin-top: 1;
}

#confirm_word {
    margin-top: 1;
    background: $surface;
    color: $foreground;
}

#confirm_buttons {
    height: auto;
    margin-top: 1;
}

#confirm_buttons Button {
    min-width: 12;
    margin-right: 1;
    color: $text;
}

/* -- local checkout path prompt -------------------------------------- */
LocalPathDialog {
    align: center middle;
    background: transparent;
}

#path_box {
    width: 62;
    height: auto;
    border: round $foreground;
    background: $surface;
    color: $text;
    padding: 1 2;
}

#path_title {
    height: auto;
    text-style: bold;
}

#path_body, #path_error {
    height: auto;
    margin-top: 1;
}

#path_error {
    color: ansi_red;
}

#path_input {
    margin-top: 1;
    background: $surface;
    color: $foreground;
}

#path_buttons {
    height: auto;
    margin-top: 1;
}

#path_buttons Button {
    min-width: 12;
    margin-right: 1;
    color: $text;
}

/* -- help overlay ---------------------------------------------------- */
HelpScreen {
    align: center middle;
    background: transparent;
}

#help_box {
    width: 46;
    height: auto;
    max-height: 90%;
    border: round $foreground;
    /* The terminal's own background: the page behind must not show through. */
    background: ansi_default;
    color: ansi_default;
    padding: 1 2;
}

#help_title {
    height: auto;
    text-style: bold;
}

#help_body {
    height: auto;
    margin-top: 1;
}

#help_close {
    height: auto;
    margin-top: 1;
    color: ansi_default;
}

/* -- the inline sudo bar (never a dialog) ----------------------------- */
#sudo_bar {
    height: auto;
    padding: 0 1;
}

#sudo_head {
    height: 1;
}

#sudo_title {
    width: 1fr;
    height: 1;
    text-style: bold;
}

#sudo_hint {
    width: auto;
    height: 1;
}

#sudo_body {
    height: auto;
}

#sudo_input_row {
    height: 1;
}

#sudo_prompt {
    width: auto;
    height: 1;
}

#sudo_input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 1;
    background: transparent;
    background-tint: transparent;
    color: ansi_default;
}

#sudo_input:focus {
    background: transparent;
    background-tint: transparent;
}

/* The cursor cell is hidden in SudoInput itself; this keeps a stray cursor
   style from painting a block if the widget is ever reused. */
#sudo_input > .input--cursor {
    background: transparent;
    color: transparent;
}

/* -- command menu and about ------------------------------------------ */
CommandMenu, AboutScreen {
    align: center middle;
    background: transparent;
}

#command_box, #about_box {
    width: 58;
    max-width: 96%;
    height: auto;
    max-height: 90%;
    border: round $foreground;
    /* The terminal's own background: the page behind must not show through. */
    background: ansi_default;
    color: ansi_default;
    padding: 1 2;
}

#command_title, #about_title {
    height: auto;
    text-style: bold;
}

#command_keys {
    height: auto;
    margin: 1 0;
}

#about_body {
    height: auto;
    margin-top: 1;
}

#about_close {
    height: auto;
    margin-top: 1;
    color: ansi_default;
}

#command_list {
    height: auto;
    max-height: 16;
    border: none;
    padding: 0;
    background: transparent;
}

/* Ctrl+C is not a quit key; its notice shrink-wraps so it sits on the right
   edge instead of floating mid-screen in a half-width box. */
Toast {
    width: auto;
}
